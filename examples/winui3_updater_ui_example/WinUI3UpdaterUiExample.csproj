<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A real WinUI 3 application (Windows App SDK) showing dazzle_updater's update windows.
    Unpackaged and self-contained: nothing has to be installed on the machine, the
    Windows App Runtime travels with the output. Build with `dotnet build`, run the .exe.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DazzleUpdater.WinUI3UpdaterUiExample</RootNamespace>
    <AssemblyName>DazzleUpdaterUiExample</AssemblyName>
    <Nullable>enable</Nullable>
    <!-- [LibraryImport] generates unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The binding is a net8.0 project reference; this keeps it a runtime asset too. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The brand mark on its tile (branding/dazzle); UpdaterUI shows the executable's icon. -->
    <ApplicationIcon>DazzleUpdaterDemo.ico</ApplicationIcon>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

  <ItemGroup>
    <!-- The project reference is what builds core/ with CMake and ships dazzle_updater.dll; the
         plain reference is what makes the binding a runtime asset of this net9.0-windows
         app, which a net8.0 project reference alone is not. -->
    <ProjectReference Include="../../bindings/csharp/DazzleUpdater.csproj" ReferenceOutputAssembly="false" />
    <Reference Include="DazzleUpdater">
      <HintPath>../../bindings/csharp/bin/$(Configuration)/net8.0/DazzleUpdater.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
