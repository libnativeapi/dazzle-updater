<?xml version="1.0" encoding="utf-8"?>
<!--
  The ordinary WinUI 3 shape, and the reason it exists here: the Fluent control styles
  live in XamlControlsResources. Merging it from a code-only Application constructor throws
  a COMException, and without it a control whose template names a Fluent resource cannot be
  templated at all — the ProgressBar brought the process down. The XAML compiler merges it
  the way every template does; the windows themselves are still built in code.
-->
<Application
    x:Class="DazzleUpdater.WinUI3UpdaterUiExample.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
