# Generates the C++/WinRT projections the Windows windows include.
#
# It runs as a script rather than as a command in add_custom_command on purpose: cppwinrt
# exits non-zero when a winmd it does not need is missing (WebView2's types come up that
# way) and still writes every header the windows use. The exit code is reported, and the
# header decides whether the generation worked.
set(generated "@DAZZLE_WINRT_GENERATED@")
set(stamp "@DAZZLE_WINRT_STAMP@")
set(log "@DAZZLE_WINRT_LOG@")
file(MAKE_DIRECTORY "${generated}")
set(metadata "@DAZZLE_WASDK_METADATA_DIRS@")
execute_process(
    COMMAND "@DAZZLE_CPPWINRT@" -in ${metadata} -out "${generated}" -ref "@DAZZLE_UNION_WINMD@"
    RESULT_VARIABLE result
    OUTPUT_FILE "${log}"
    ERROR_FILE "${log}")
if(NOT EXISTS "${generated}/winrt/Microsoft.UI.Xaml.h")
    message(FATAL_ERROR "cppwinrt wrote no projections (exit ${result}); see ${log}")
endif()
file(TOUCH "${stamp}")
message(STATUS "C++/WinRT projections generated by @DAZZLE_CPPWINRT@ (exit ${result})")
