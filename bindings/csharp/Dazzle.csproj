<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Dazzle</RootNamespace>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Dazzle</PackageId>
    <Version>0.0.1</Version>
    <Description>A Sparkle-compatible software update framework.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- The example and test projects live below this directory; keep their sources out. -->
  <ItemGroup>
    <Compile Remove="examples/**;tests/**" />
    <None Remove="examples/**;tests/**" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    Build the dazzle core (bindings/csharp -> core/) as a shared library with CMake and
    ship it next to the managed assembly, so [LibraryImport("dazzle")] resolves it.
  -->
  <PropertyGroup>
    <DazzleCoreDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../core'))</DazzleCoreDir>
    <DazzleCMakeDir>$(MSBuildThisFileDirectory)obj/cmake</DazzleCMakeDir>
    <DazzleLibraryName Condition="$([MSBuild]::IsOSPlatform('Windows'))">dazzle.dll</DazzleLibraryName>
    <DazzleLibraryName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libdazzle.dylib</DazzleLibraryName>
    <DazzleLibraryName Condition="'$(DazzleLibraryName)' == ''">libdazzle.so</DazzleLibraryName>
    <!-- Visual Studio generators add a per-configuration directory. -->
    <DazzleLibraryPath Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(DazzleCMakeDir)/src/Release/$(DazzleLibraryName)</DazzleLibraryPath>
    <DazzleLibraryPath Condition="'$(DazzleLibraryPath)' == ''">$(DazzleCMakeDir)/src/$(DazzleLibraryName)</DazzleLibraryPath>
    <DazzleRuntimeId>$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier)</DazzleRuntimeId>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(DazzleLibraryPath)"
          Link="$(DazzleLibraryName)"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="runtimes/$(DazzleRuntimeId)/native/" />
  </ItemGroup>

  <Target Name="BuildDazzleCore" BeforeTargets="BeforeBuild">
    <Exec Command="cmake -S &quot;$(DazzleCoreDir)&quot; -B &quot;$(DazzleCMakeDir)&quot; -DDAZZLE_BUILD_SHARED=ON -DBUILD_TESTING=OFF -DCMAKE_BUILD_TYPE=Release" />
    <Exec Command="cmake --build &quot;$(DazzleCMakeDir)&quot; --target dazzle --config Release" />
    <Error Condition="!Exists('$(DazzleLibraryPath)')" Text="dazzle: $(DazzleLibraryPath) was not built." />
  </Target>

</Project>
